{
  "name": "nudge",
  "productName": "Nudge",
  "version": "2.0.0-beta.1",
  "description": "A warm, offline-first cross-platform todo, focus, and learning planner",
  "author": "Nudge",
  "license": "MIT",
  "scripts": {
    "dev": "tauri dev",
    "dev:web": "vite --config vite.config.ts",
    "start": "vite preview --config vite.config.ts",
    "tauri": "tauri",
    "typecheck": "npm run typecheck:web",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "build:web": "vite build --config vite.config.ts",
    "build": "npm run typecheck && tauri build",
    "build:win": "npm run build -- --bundles nsis",
    "android:init": "tauri android init --ci",
    "android:dev": "tauri android dev",
    "android:build": "tauri android build --apk --target aarch64 --ci",
    "android:build:windows": "powershell -ExecutionPolicy Bypass -File scripts/build-android-windows.ps1",
    "ios:init": "tauri ios init --ci",
    "ios:dev": "tauri ios dev",
    "ios:build": "tauri ios build --ci",
    "check:rust": "cargo fmt --manifest-path src-tauri/Cargo.toml -- --check && cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets --all-features -- -D warnings && cargo test --manifest-path src-tauri/Cargo.toml",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@dagrejs/dagre": "^1.1.8",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tauri-apps/api": "^2.8.0",
    "@tauri-apps/plugin-dialog": "^2.4.0",
    "@tauri-apps/plugin-stronghold": "^2.3.0",
    "@xyflow/react": "^12.8.4",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.468.0",
    "lxgw-wenkai-screen-webfont": "^1.7.0",
    "motion": "^12.43.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.3.6",
    "zustand": "^5.0.10"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.8.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "jsdom": "^27.4.0",
    "typescript": "^5.9.3",
    "vite": "^7.2.6",
    "vitest": "^4.0.16"
  }
}
